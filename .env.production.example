# WACRM Docker Compose production template for ARVERA.
# Copy to .env.production and paste the real secret values from the server.
# Do not commit .env.production.

# -------------------------------------------------------------------
# Postgres
# -------------------------------------------------------------------
POSTGRES_IMAGE=postgres:18-alpine
POSTGRES_DB=wavera
POSTGRES_USER=arv
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_PORT=5432
DATABASE_URL=postgres://arv:change-me-postgres-password@postgres:5432/wavera
DATABASE_POOL_MAX=10

# -------------------------------------------------------------------
# WACRM
# -------------------------------------------------------------------
WACRM_PORT=3001
NEXT_PUBLIC_SITE_URL=https://wacrm.arvera.es
BETTER_AUTH_URL=https://wacrm.arvera.es
BETTER_AUTH_SECRET=change-me-better-auth-secret
NEXT_PUBLIC_APP_LOCALE=es
PLATFORM_BOOTSTRAP_ADMIN_EMAILS=admin@arvera.es
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change-me-64-hex-characters
META_APP_SECRET=change-me-meta-app-secret

# -------------------------------------------------------------------
# Soketi / Pusher-compatible realtime
# -------------------------------------------------------------------
SERVICE_URL_SOKETI=https://soketi.arvera.es
SERVICE_URL_SOKETI_6001=https://soketi.arvera.es:6001
SERVICE_USER_SOKETI=0jEQKRk60CjyDc6T
SERVICE_REALBASE64_64_SOKETIKEY=change-me-soketi-key
SERVICE_REALBASE64_64_SOKETISECRET=change-me-soketi-secret

SOKETI_APP_ID=${SERVICE_USER_SOKETI}
NEXT_PUBLIC_SOKETI_APP_KEY=${SERVICE_REALBASE64_64_SOKETIKEY}
SOKETI_APP_SECRET=${SERVICE_REALBASE64_64_SOKETISECRET}

# Internal server-side WACRM -> Soketi connection.
SOKETI_HOST=soketi
SOKETI_PORT=6001
SOKETI_TLS=false

# Browser-side websocket endpoint.
NEXT_PUBLIC_SOKETI_HOST=soketi.arvera.es
NEXT_PUBLIC_SOKETI_PORT=443
NEXT_PUBLIC_SOKETI_TLS=true
NEXT_PUBLIC_SOKETI_CLUSTER=mt1

SOKETI_PORT_PUBLIC=6001
SOKETI_METRICS_PORT_PUBLIC=9601
SOKETI_DEBUG=0
SOKETI_PUSHER_SCHEME=https
DEFAULT_APP_ENABLE_CLIENT_MESSAGES=

# -------------------------------------------------------------------
# Alarik real
# -------------------------------------------------------------------
ALARIK_API_PORT=8080
ALARIK_CONSOLE_PORT=3000
ALARIK_API_BASE_URL=https://s3.arvera.es
ALARIK_CONSOLE_BASE_URL=https://alarik.arvera.es
ALARIK_ADMIN_USERNAME=alarik
ALARIK_ADMIN_PASSWORD=change-me-alarik-admin-password
ALARIK_JWT=change-me-long-random-jwt-secret
ALARIK_ALLOW_ACCOUNT_CREATION=false
ALARIK_CORS_ALLOW_ORIGINS=https://alarik.arvera.es,https://wacrm.arvera.es

# -------------------------------------------------------------------
# WACRM media storage
# -------------------------------------------------------------------
# WACRM currently uses S3-compatible calls for media upload/download.
# These are the values currently used by WACRM in Coolify.
S3_ENDPOINT=https://s3.arvera.es
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_BUCKET=wacrm-media
S3_ACCESS_KEY_ID=change-me-s3-access-key
S3_SECRET_ACCESS_KEY=change-me-s3-secret-key
S3_PUBLIC_BASE_URL=https://s3.arvera.es/wacrm-media

# -------------------------------------------------------------------
# Optional cron/integration secrets
# -------------------------------------------------------------------
AUTOMATION_CRON_SECRET=change-me-cron-secret
# META_APP_ID=change-me-meta-app-id
# PAYMENT_LINKS_API_KEY=
# ARVERA_APPOINTMENTS_API_TOKEN=

# -------------------------------------------------------------------
# WhaTicket migration defaults
# -------------------------------------------------------------------
WHATICKET_DB_HOST=ppt6w0ho4yywicm0yon1tt4d
WHATICKET_DB_PORT=5432
WHATICKET_DB_NAME=whaticket_import_tmp
WHATICKET_DB_USER=postgres
WHATICKET_DB_PASS=change-me-whaticket-bridge-password
EXPORT_DIR=/app/storage/whaticket-export
